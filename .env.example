SERVICE_PASSWORD_POSTGRES=replace-with-a-random-database-password
DATABASE_URL=postgresql://rasa_ui:replace-with-a-random-database-password@localhost:5432/rasa_ui?schema=public
AUTH_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-at-least-12-random-characters
RASA_BASE_URL=http://localhost:5005
RASA_ORIGIN_HOST=rasa.pleiades.solutions
RASA_ORIGIN_IP=host-gateway
RASA_API_TOKEN=replace-with-the-token-configured-on-rasa
LITELLM_BASE_URL=https://litellm.example.com/v1
LITELLM_API_KEY=replace-with-the-existing-litellm-key
LITELLM_MODEL=gpt-5.6-luna
NEXT_PUBLIC_APP_URL=http://localhost:3000
INTERNAL_MODEL_SERVER_URL=http://host.docker.internal:3000
MODEL_DOWNLOAD_TOKEN=replace-with-a-different-32-character-random-token
RASA_TRAINING_TIMEOUT_MS=1800000
TRAINING_WORKER_ENABLED=true
